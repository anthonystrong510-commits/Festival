{
  "entities": {
    "VendorApplication": {
      "title": "VendorApplication",
      "description": "Submitted application from a small business or vendor wishing to exhibit at the festival.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the application"
        },
        "businessName": {
          "type": "string",
          "description": "Registered name of the business or artisan brand",
          "maxLength": 150
        },
        "contactName": {
          "type": "string",
          "description": "Primary contact person name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 50
        },
        "website": {
          "type": "string",
          "description": "Business website, Instagram, or social link",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Vendor product category",
          "maxLength": 100
        },
        "selectedBoothId": {
          "type": "string",
          "description": "Selected booth space tier ID",
          "maxLength": 50
        },
        "selectedDays": {
          "type": "array",
          "description": "List of festival days selected for booking"
        },
        "productDescription": {
          "type": "string",
          "description": "Detailed description of products or services offered",
          "maxLength": 1000
        },
        "photoLinks": {
          "type": "string",
          "description": "Links or notes regarding product photos",
          "maxLength": 500
        },
        "isFoodVendor": {
          "type": "boolean",
          "description": "Whether the vendor serves food or edible items"
        },
        "hasFoodPermit": {
          "type": "boolean",
          "description": "Whether the vendor has required food permits"
        },
        "tempHygieneCompliant": {
          "type": "boolean",
          "description": "Whether food vendor is compliant with temperature and hygiene guidelines"
        },
        "needsHandicapParking": {
          "type": "boolean",
          "description": "Whether accessibility or handicap parking is requested"
        },
        "handicapNotes": {
          "type": "string",
          "description": "Special accessibility requirements",
          "maxLength": 500
        },
        "additionalRequests": {
          "type": "string",
          "description": "Any additional requests or notes",
          "maxLength": 500
        },
        "agreedToTerms": {
          "type": "boolean",
          "description": "Confirmation that vendor agreed to festival terms and conditions"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "waitlist", "paid"],
          "description": "Application review and confirmation status"
        },
        "totalCalculatedFee": {
          "type": "number",
          "description": "Total booth fee calculated based on days and tier"
        },
        "boothZoneAssignment": {
          "type": "string",
          "description": "Assigned zone or booth location on the festival map",
          "maxLength": 100
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal organizer review notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when application was submitted"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when application was last modified"
        }
      },
      "required": ["businessName", "contactName", "email", "category", "selectedBoothId", "selectedDays", "status", "createdAt"]
    },
    "AttendeeRsvp": {
      "title": "AttendeeRsvp",
      "description": "Visitor RSVP registration for free festival admission pass.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the RSVP"
        },
        "name": {
          "type": "string",
          "description": "Attendee full name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Attendee email address",
          "maxLength": 150
        },
        "daysAttending": {
          "type": "array",
          "description": "Days attendee plans to visit"
        },
        "interests": {
          "type": "array",
          "description": "Selected festival interests and categories"
        },
        "groupSize": {
          "type": "number",
          "description": "Number of attendees in the party"
        },
        "newsletterOptIn": {
          "type": "boolean",
          "description": "Whether attendee opted in for future festival newsletters"
        },
        "checkedIn": {
          "type": "boolean",
          "description": "Whether attendee has checked in at the festival gate"
        },
        "checkedInAt": {
          "type": "string",
          "description": "Timestamp of gate check-in"
        },
        "passCode": {
          "type": "string",
          "description": "Unique ticket pass code for quick QR/barcode lookup",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when RSVP was registered"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when RSVP was last updated"
        }
      },
      "required": ["name", "email", "daysAttending", "groupSize", "createdAt"]
    },
    "FestivalConfig": {
      "title": "FestivalConfig",
      "description": "Global festival configuration, venue details, and public admission settings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Configuration document ID"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "shortName": {
          "type": "string",
          "maxLength": 100
        },
        "heroHeadline": {
          "type": "string",
          "maxLength": 200
        },
        "edition": {
          "type": "string",
          "maxLength": 150
        },
        "tagline": {
          "type": "string",
          "maxLength": 250
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "venueName": {
          "type": "string",
          "maxLength": 200
        },
        "venueArea": {
          "type": "string",
          "maxLength": 150
        },
        "address": {
          "type": "string",
          "maxLength": 250
        },
        "cityState": {
          "type": "string",
          "maxLength": 150
        },
        "fullLocation": {
          "type": "string",
          "maxLength": 300
        },
        "mapQuery": {
          "type": "string",
          "maxLength": 200
        },
        "datesSummary": {
          "type": "string",
          "maxLength": 150
        },
        "durationBadge": {
          "type": "string",
          "maxLength": 100
        },
        "admissionBadge": {
          "type": "string",
          "maxLength": 100
        },
        "locationBadge": {
          "type": "string",
          "maxLength": 100
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 150
        },
        "freeAdmission": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["name", "contactEmail", "updatedAt"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "HTML and plain text email template with anti-spam compliance scoring and dynamic variables.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "maxLength": 250
        },
        "previewText": {
          "type": "string",
          "maxLength": 250
        },
        "htmlBody": {
          "type": "string",
          "maxLength": 20000
        },
        "plainTextBody": {
          "type": "string",
          "maxLength": 10000
        },
        "dynamicVariables": {
          "type": "array"
        },
        "antiSpamScore": {
          "type": "number"
        },
        "spamAdvice": {
          "type": "array"
        },
        "isCustom": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["key", "title", "subject", "htmlBody", "updatedAt"]
    },
    "SmtpConfig": {
      "title": "SmtpConfig",
      "description": "Outgoing email SMTP server configuration, credentials, and anti-spam deliverability rules.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "maxLength": 150
        },
        "port": {
          "type": "number"
        },
        "secure": {
          "type": "boolean"
        },
        "username": {
          "type": "string",
          "maxLength": 150
        },
        "password": {
          "type": "string",
          "maxLength": 150
        },
        "fromName": {
          "type": "string",
          "maxLength": 100
        },
        "fromEmail": {
          "type": "string",
          "maxLength": 150
        },
        "replyToEmail": {
          "type": "string",
          "maxLength": 150
        },
        "rateLimitPerHour": {
          "type": "number"
        },
        "spfRecord": {
          "type": "string",
          "maxLength": 200
        },
        "dkimSelector": {
          "type": "string",
          "maxLength": 100
        },
        "dmarcPolicy": {
          "type": "string",
          "maxLength": 200
        },
        "isEnabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["host", "port", "fromEmail", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator account with management permissions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "admin"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["email", "role"]
    },
    "OutboundEmailLog": {
      "title": "OutboundEmailLog",
      "description": "Log of automated transactional emails dispatched to vendors and attendees.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "recipientEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "recipientName": {
          "type": "string",
          "maxLength": 100
        },
        "templateKey": {
          "type": "string",
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "maxLength": 250
        },
        "plainText": {
          "type": "string",
          "maxLength": 10000
        },
        "htmlBody": {
          "type": "string",
          "maxLength": 25000
        },
        "status": {
          "type": "string",
          "enum": ["delivered", "simulated", "failed", "pending"]
        },
        "antiSpamScore": {
          "type": "number"
        },
        "sentAt": {
          "type": "string"
        }
      },
      "required": ["recipientEmail", "subject", "status", "sentAt"]
    },
    "PaymentConfig": {
      "title": "PaymentConfig",
      "description": "Festival payment gateway configuration including sponsor crypto (Kraken, CashApp) and on-chain addresses (USDT, ETH, BTC).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "usdtTrc20": {
          "type": "string",
          "maxLength": 150
        },
        "usdtErc20": {
          "type": "string",
          "maxLength": 150
        },
        "usdtSolana": {
          "type": "string",
          "maxLength": 150
        },
        "ethereumAddress": {
          "type": "string",
          "maxLength": 150
        },
        "ethereumEns": {
          "type": "string",
          "maxLength": 100
        },
        "bitcoinAddress": {
          "type": "string",
          "maxLength": 150
        },
        "bitcoinLightning": {
          "type": "string",
          "maxLength": 150
        },
        "cashAppCashtag": {
          "type": "string",
          "maxLength": 100
        },
        "cashAppBtcAddress": {
          "type": "string",
          "maxLength": 150
        },
        "cashAppEnabled": {
          "type": "boolean"
        },
        "krakenPayId": {
          "type": "string",
          "maxLength": 150
        },
        "krakenDepositAddress": {
          "type": "string",
          "maxLength": 150
        },
        "krakenSponsorBadgeEnabled": {
          "type": "boolean"
        },
        "bankName": {
          "type": "string",
          "maxLength": 150
        },
        "bankAccountName": {
          "type": "string",
          "maxLength": 150
        },
        "bankAccountNumber": {
          "type": "string",
          "maxLength": 100
        },
        "bankRoutingNumber": {
          "type": "string",
          "maxLength": 100
        },
        "bankSwiftBic": {
          "type": "string",
          "maxLength": 100
        },
        "zelleHandle": {
          "type": "string",
          "maxLength": 150
        },
        "paymentInstructions": {
          "type": "string",
          "maxLength": 2000
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Itemized payment invoice sent to vendor or sponsor with direct checkout link and crypto payment options.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "invoiceNumber": {
          "type": "string",
          "maxLength": 50
        },
        "vendorApplicationId": {
          "type": "string",
          "maxLength": 100
        },
        "recipientBusinessName": {
          "type": "string",
          "maxLength": 150
        },
        "recipientContactName": {
          "type": "string",
          "maxLength": 100
        },
        "recipientEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "recipientPhone": {
          "type": "string",
          "maxLength": 50
        },
        "recipientAddress": {
          "type": "string",
          "maxLength": 250
        },
        "issueDate": {
          "type": "string"
        },
        "dueDate": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "sent", "paid", "under_review", "overdue", "cancelled"]
        },
        "items": {
          "type": "array"
        },
        "subtotal": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "taxAmount": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "maxLength": 10
        },
        "notes": {
          "type": "string",
          "maxLength": 1500
        },
        "terms": {
          "type": "string",
          "maxLength": 1500
        },
        "cryptoAddresses": {
          "type": "object"
        },
        "paymentDetailsSubmitted": {
          "type": "object"
        },
        "sentAt": {
          "type": "string"
        },
        "paidAt": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["invoiceNumber", "recipientEmail", "totalAmount", "status", "issueDate", "dueDate", "createdAt"]
    }
  },
  "firestore": {
    "/vendor_applications/{applicationId}": {
      "schema": "VendorApplication",
      "description": "Collection of vendor applications submitted via public form or admin panel."
    },
    "/attendee_rsvps/{rsvpId}": {
      "schema": "AttendeeRsvp",
      "description": "Collection of attendee registrations for festival passes and gate check-ins."
    },
    "/festival_config/{configId}": {
      "schema": "FestivalConfig",
      "description": "Global festival settings and event configuration document."
    },
    "/email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Customizable email templates with anti-spam compliance scoring."
    },
    "/email_config/{configId}": {
      "schema": "SmtpConfig",
      "description": "SMTP and anti-spam deliverability configurations."
    },
    "/payment_config/{configId}": {
      "schema": "PaymentConfig",
      "description": "Crypto addresses (USDT, ETH, BTC) and sponsor gateways (Kraken, CashApp)."
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices with itemized line items, checkout links, and crypto payment options."
    },
    "/outbound_email_logs/{logId}": {
      "schema": "OutboundEmailLog",
      "description": "Transactional automated email logs."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized administrators."
    }
  }
}

