rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muokltd@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Vendor Applications
    match /vendor_applications/{applicationId} {
      allow create: if isValidId(applicationId) &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() <= 150 &&
        request.resource.data.contactName is string &&
        request.resource.data.contactName.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.category is string &&
        request.resource.data.selectedBoothId is string &&
        request.resource.data.selectedDays is list &&
        request.resource.data.selectedDays.size() >= 1 &&
        request.resource.data.status is string;

      allow read: if isAdmin() || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );

      allow update, delete: if isAdmin();
    }

    // Attendee RSVPs
    match /attendee_rsvps/{rsvpId} {
      allow create: if isValidId(rsvpId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.daysAttending is list &&
        request.resource.data.daysAttending.size() >= 1 &&
        request.resource.data.groupSize is number;

      allow read, update, delete: if isAdmin();
    }

    // Public Festival Configuration
    match /festival_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email Templates (Public read for automated delivery, admin write)
    match /email_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SMTP Configuration (Public read for sender details, admin write)
    match /email_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment & Crypto Configuration (Public read for checkout crypto addresses, admin write)
    match /payment_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Invoices with Checkout & Crypto Payment Tracking
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isValidId(invoiceId) &&
        request.resource.data.invoiceNumber is string &&
        request.resource.data.recipientEmail is string &&
        request.resource.data.totalAmount is number &&
        request.resource.data.status is string
      );
      allow update: if isAdmin() || (
        // Allow vendor to submit payment txHash / receipt proof
        resource.data.id == invoiceId &&
        request.resource.data.invoiceNumber == resource.data.invoiceNumber &&
        request.resource.data.totalAmount == resource.data.totalAmount
      );
      allow delete: if isAdmin();
    }

    // Outbound Email Logs
    match /outbound_email_logs/{logId} {
      allow create: if isValidId(logId) &&
        request.resource.data.recipientEmail is string &&
        request.resource.data.recipientEmail.size() <= 150 &&
        request.resource.data.subject is string;
      allow read, update, delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
